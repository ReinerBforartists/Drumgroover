# Embeds the table packages of the closed hi-hat hybrid model (resources/models/hc_a<anchor>.hcpk, one per accent anchor, ~11 MB each) into the plugin DLL as
# Windows resources (RCDATA "DGG_HC_A<anchor>"), so the plugin needs no files next to it. The packages are read in place (LockResource), nothing is copied.
# A C array (as dgg_embed_web_resources does for the small web files) is not used: 54 MB would be a 270 MB source file.
# The packages are generated from the model data by tools/_sweep/wrenfold_hc (make_hcpk.py); the version stored in a package must match hch::kModelVer.
function(dgg_embed_hc_models out_rc models_dir)
  set(anchors 25 50 75 100 127)
  set(lines "// Generated by cmake/DggEmbedHcModels.cmake -- do not edit.\n")
  foreach(a ${anchors})
    set(f "${models_dir}/hc_a${a}.hcpk")
    if(NOT EXISTS "${f}")
      message(FATAL_ERROR "Missing HC model package ${f}. Place hc_a25/50/75/100/127.hcpk (tools/_sweep/wrenfold_hc/hcpk) in ${models_dir}.")
    endif()
    # Re-run configure (and so rebuild the resource) whenever a package changes.
    if(NOT CMAKE_SCRIPT_MODE_FILE)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${f}")
    endif()
    string(APPEND lines "DGG_HC_A${a} RCDATA \"${f}\"\n")
  endforeach()
  set(tmp "${out_rc}.tmp")
  file(WRITE "${tmp}" "${lines}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${tmp}" "${out_rc}")
  if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_source_files_properties("${out_rc}" PROPERTIES OBJECT_DEPENDS "${models_dir}/hc_a25.hcpk;${models_dir}/hc_a50.hcpk;${models_dir}/hc_a75.hcpk;${models_dir}/hc_a100.hcpk;${models_dir}/hc_a127.hcpk")
  endif()
endfunction()
